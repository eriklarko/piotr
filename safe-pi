#!/usr/bin/env bash
# safe-pi — run the pi coding agent in a Docker Sandbox against $PWD.
# Install: `make install` (symlinks this file into ~/.local/bin/safe-pi).
set -euo pipefail

resolve_self() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  echo "$(cd -P "$(dirname "$src")" && pwd)"
}

REPO_DIR="$(resolve_self "$0")"
# Tracked config comes from this repo; machine-local state comes from ~/.pi,
# where pi writes it directly. Repo paths are read at their real location
# rather than through the ~/.pi symlinks, so sbx never has to resolve one when
# setting up mounts.
EXT_DIR="$REPO_DIR/extensions"
SKILLS_DIR="$REPO_DIR/skills"
REPO_CONFIG_DIR="$REPO_DIR/config"
SANDBOX_DIR="$REPO_DIR/docker-sandbox"
PI_DIR="$HOME/.pi"

KIT_DIR="$SANDBOX_DIR"
HOST_SETTINGS="$REPO_CONFIG_DIR/settings.json"
# The exact versions tracked for installed-extensions/, used to pin
# sync_packages' 'npm:' installs to what the host actually resolved.
NPM_PKG_JSON="$REPO_DIR/installed-extensions/package.json"

# Global pi extensions, shared read-only with every sandbox.
# pi auto-discovers ~/.pi/agent/extensions/*.ts and */index.ts.
HOST_EXT_DIR="$EXT_DIR"

# Global pi skills, shared read-only with every sandbox.
# pi discovers them under ~/.pi/agent/skills/<name>/SKILL.md.
HOST_SKILLS_DIR="$SKILLS_DIR"

# In-VM landing spots for HOST_EXT_DIR/HOST_SKILLS_DIR when they cannot be
# bind-mounted read-only (see link_ro_source below).
RO_COPY_EXT="/usr/lib/pi-kit/extensions"
RO_COPY_SKILLS="/usr/lib/pi-kit/skills"

# Pi keybindings, shared read-only with every sandbox.
HOST_KEYBINDINGS="$REPO_CONFIG_DIR/keybindings.json"

# Pi sessions, shared read-write with every sandbox.
# pi stores sessions under ~/.pi/agent/sessions/--<encoded-cwd>--/.
HOST_SESSIONS_DIR="$PI_DIR/agent/sessions"

# Provider credentials. Copied into each sandbox at creation so a single
# /login covers every sandbox, and saved back out by 'safe-pi login'.
HOST_AUTH="$PI_DIR/agent/auth.json"

die() { echo "safe-pi: $*" >&2; exit 1; }
info() { echo "safe-pi: $*" >&2; }

need_sbx() {
  command -v sbx >/dev/null 2>&1 || die "sbx not found. Install it with 'brew install docker/tap/sbx' and run 'sbx login'."
}

# The kit boots an image built from docker-sandbox/Dockerfile. sbx keeps its own
# image store, so if that image was never built sbx assumes it is a registry
# reference and fails with an opaque "403 Forbidden: pull failed". Check for it
# up front and name the fix instead.
need_image() {
  local image repo tag
  image="$(sed -nE 's|^  image: "([^"]+)"$|\1|p' "$SANDBOX_DIR/spec.yaml" | head -1)"
  [ -n "$image" ] || die "no sandbox image found in $SANDBOX_DIR/spec.yaml"
  # A reference with a registry path (docker/foo:tag) is sbx's to pull.
  case "$image" in */*) return 0 ;; esac
  repo="${image%:*}"
  tag="${image##*:}"
  sbx template ls 2>/dev/null \
    | awk -v r="$repo" -v t="$tag" 'NR>1 { n=$1; sub(/^.*\//, "", n); if (n==r && $2==t) found=1 } END { exit !found }' \
    || die "sandbox image '$image' is not in the sbx image store. Build it with 'make image' in $REPO_DIR."
}

# Sandbox name derived from the workspace directory, so re-running from the
# same project reconnects instead of creating a second VM.
sandbox_name() {
  local raw name
  raw="$(basename "$1")"
  name="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]-' '-' | sed 's/-\{2,\}/-/g; s/^-*//; s/-*$//')"
  [ -n "$name" ] || name=workspace
  printf 'pi-%s' "$name"
}

sandbox_exists() {
  sbx ls 2>/dev/null | awk -v n="$1" 'NR>1 && $1==n { found=1 } END { exit !found }'
}

# True when a global github service secret is already stored.
github_secret_exists() {
  sbx secret ls 2>/dev/null \
    | awk 'NR>1 && $1=="(global)" && $3=="github" { found=1 } END { exit !found }'
}

# Store the GitHub token on the host. The real value never enters the VM; the
# host proxy injects it into outbound GitHub requests.
#
# $1 = "force" to replace a secret that is already stored. Without it an
# existing secret is left alone, because 'sbx secret set' asks to confirm an
# overwrite and sandbox creation must never stop on a prompt.
store_github_secret() {
  local force="${1:-}" token="${GITHUB_TOKEN:-}"
  if [ -z "$token" ] && command -v gh >/dev/null 2>&1; then
    token="$(gh auth token 2>/dev/null || true)"
  fi
  if [ -z "$token" ]; then
    info "no GitHub token found (run 'gh auth login', or set GITHUB_TOKEN) — gh inside the sandbox will not be authenticated"
    return 0
  fi
  if github_secret_exists; then
    if [ "$force" != "force" ]; then
      info "GitHub sbx secret already stored — leaving it alone ('safe-pi login' replaces it)"
      return 0
    fi
    # Remove first rather than confirming an overwrite: the token occupies
    # stdin, so there is nothing left to answer the prompt with, and the
    # --force flag on 'set' only applies to --token, which would expose the
    # token in argv where 'ps' can read it.
    sbx secret rm github -f >/dev/null 2>&1 || true
  fi
  # Report what actually happened: a cancelled or failed 'set' otherwise
  # looks identical to a successful one.
  if printf '%s' "$token" | sbx secret set github >/dev/null 2>&1; then
    info "stored GitHub token as a global sbx secret"
  else
    info "could not store the GitHub token as an sbx secret — 'gh' in new sandboxes may be unauthenticated; try 'safe-pi login'"
  fi
}

# Allow the sandbox to reach a model server on the host. The proxy rewrites
# host.docker.internal to localhost, so the policy rule targets localhost.
apply_offline_policy() {
  [ -n "${OFFLINE_PORT:-}" ] || return 0
  info "allowing sandbox to reach host model server on localhost:$OFFLINE_PORT"
  sbx policy allow network "localhost:${OFFLINE_PORT}"
}

# Point pi at the host model server. localhost inside the VM is the VM itself,
# so the base URL must use host.docker.internal.
configure_offline_model() {
  local name="$1"
  [ -n "${OFFLINE_PORT:-}" ] || return 0
  [ -n "${OFFLINE_MODEL:-}" ] || die "OFFLINE_PORT is set but OFFLINE_MODEL is empty"

  info "pointing pi at http://host.docker.internal:${OFFLINE_PORT}/v1 (model: ${OFFLINE_MODEL})"
  sbx exec -i "$name" bash -c 'mkdir -p ~/.pi/agent && cat > ~/.pi/agent/models.json' <<EOF
{
  "providers": {
    "llama-cpp": {
      "baseUrl": "http://host.docker.internal:${OFFLINE_PORT}/v1",
      "api": "openai-completions",
      "apiKey": "none",
      "models": [
        { "id": "${OFFLINE_MODEL}" }
      ]
    }
  }
}
EOF

  # Merge rather than overwrite: pi and sync_packages also write to this file.
  merge_settings "$name" <<EOF
{
  "defaultProvider": "llama-cpp",
  "defaultModel": "${OFFLINE_MODEL}",
  "autocompleteMaxVisible": 7,
  "defaultThinkingLevel": "off"
}
EOF
}

# Shallow-merge a JSON object from stdin into the sandbox's ~/.pi/agent/settings.json.
merge_settings() {
  local name="$1"
  sbx exec -i "$name" bash -lc 'mkdir -p ~/.pi/agent && node -e "
    const fs = require(\"fs\");
    const file = process.env.HOME + \"/.pi/agent/settings.json\";
    const patch = JSON.parse(fs.readFileSync(0, \"utf8\"));
    let current = {};
    try { current = JSON.parse(fs.readFileSync(file, \"utf8\")); } catch {}
    fs.writeFileSync(file, JSON.stringify({ ...current, ...patch }, null, 2) + \"\\n\");
  "'
}

# Mirror the host's global pi packages (~/.pi/agent/settings.json "packages")
# into the sandbox. The installed tree is not shared: the host's node_modules
# is built for macOS, so each package is installed natively inside the VM with
# `pi install`, then the host's package list (including any filters) is copied
# over verbatim. Local-path packages are skipped since the path does not exist
# in the VM.
#
# 'npm:' sources are pinned to the exact version tracked in
# installed-extensions/package.json before being sent to the VM, so a sandbox
# installs the same version the host resolved and its package-lock.json
# pins -- not whatever is newest on npm that day. An entry that already
# carries its own '@version' is left alone.
sync_packages() {
  local name="$1" host_settings="$HOST_SETTINGS"
  [ -f "$host_settings" ] || return 0
  info "syncing pi packages from $host_settings into the sandbox"
  local pinned_settings
  pinned_settings="$(node -e '
    const fs = require("fs");
    const settings = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    let pins = {};
    try { pins = JSON.parse(fs.readFileSync(process.argv[2], "utf8")).dependencies || {}; } catch {}
    const pin = (source) => {
      if (typeof source !== "string" || !source.startsWith("npm:")) return source;
      const spec = source.slice(4);
      const at = spec.lastIndexOf("@");
      if (at > 0) return source; // already carries its own @version
      const version = pins[spec];
      return version ? "npm:" + spec + "@" + version : source;
    };
    const packages = Array.isArray(settings.packages) ? settings.packages : [];
    settings.packages = packages.map((entry) =>
      typeof entry === "string" ? pin(entry) : { ...entry, source: pin(entry && entry.source) }
    );
    process.stdout.write(JSON.stringify(settings));
  ' "$host_settings" "$NPM_PKG_JSON")"

  sbx exec -i "$name" bash -lc 'node -e "
    const fs = require(\"fs\");
    const { execFileSync } = require(\"child_process\");
    const host = JSON.parse(fs.readFileSync(0, \"utf8\"));
    const packages = Array.isArray(host.packages) ? host.packages : [];
    const keep = [];
    for (const entry of packages) {
      const source = typeof entry === \"string\" ? entry : entry && entry.source;
      if (!source) continue;
      if (source.startsWith(\"/\") || source.startsWith(\".\")) {
        console.error(\"safe-pi: skipping local-path package \" + source + \" (not present in the VM)\");
        continue;
      }
      console.error(\"safe-pi: pi install \" + source);
      execFileSync(\"/usr/lib/pi-kit/pi/node_modules/.bin/pi\", [\"install\", source], { stdio: [\"ignore\", \"inherit\", \"inherit\"] });
      keep.push(entry);
    }
    const file = process.env.HOME + \"/.pi/agent/settings.json\";
    let current = {};
    try { current = JSON.parse(fs.readFileSync(file, \"utf8\")); } catch {}
    current.packages = keep;
    fs.writeFileSync(file, JSON.stringify(current, null, 2) + \"\\n\");
  "' <<< "$pinned_settings"
}

# A package's runtime config has nowhere else to live: pi has exactly one
# settings file, so a package's config sits next to 'packages' under a
# top-level key named after the package (installed-extensions/README.md's
# 'tldr' example). Mirror every such key into the sandbox, since sync_packages
# above only carries the 'packages' list itself. 'packages' and
# 'lastChangelogVersion' are excluded: the former is handled by sync_packages,
# the latter is host-only bookkeeping pi writes on first run.
sync_package_config() {
  local name="$1" host_settings="$HOST_SETTINGS"
  [ -f "$host_settings" ] || return 0
  local config
  config="$(node -e '
    const fs = require("fs");
    const { packages, lastChangelogVersion, ...rest } = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(JSON.stringify(rest));
  ' "$host_settings")"
  [ "$config" = "{}" ] && return 0
  info "syncing package config from $host_settings into the sandbox"
  merge_settings "$name" <<< "$config"
}

# 'sbx cp' lands a file owned by the host uid (501 on macOS), not by the VM's
# agent user. A mode-600 file copied in is then unreadable by pi, which shows
# up as "not logged in" rather than as a permission error. Reset the owner
# after every copy into ~/.pi.
claim_for_agent() {
  local name="$1" path="$2" mode="$3"
  sbx exec "$name" sudo chown agent:agent "$path"
  sbx exec "$name" sudo chmod "$mode" "$path"
}

# Provider credentials, copied in at creation so one '/login' serves every
# sandbox. Unlike the GitHub token, the real value does enter the VM: pi talks
# to the provider itself and there is no proxy injecting it on the way out.
# True when the host has credentials worth copying. pi leaves an empty "{}"
# behind after a logout or a bare start, and copying that in would report
# success while leaving the sandbox unauthenticated.
have_host_auth() {
  [ -s "$HOST_AUTH" ] || return 1
  [ "$(tr -d '[:space:]' < "$HOST_AUTH")" != "{}" ]
}

copy_auth_in() {
  local name="$1"
  if ! have_host_auth; then
    info "no provider credentials at $HOST_AUTH — run '/login' inside the sandbox, then 'safe-pi login' to keep them for the next one"
    return 0
  fi
  sbx cp "$HOST_AUTH" "$name:/home/agent/.pi/agent/auth.json"
  claim_for_agent "$name" /home/agent/.pi/agent/auth.json 600
  info "copied provider credentials from $HOST_AUTH"
}

# Save a sandbox's provider credentials back to the host, so later sandboxes
# inherit them. This is what makes '/login' a one-time step rather than one
# per sandbox, and is why setup never has to run pi on the host.
save_auth_out() {
  local name="$1"
  if ! sbx exec "$name" test -f /home/agent/.pi/agent/auth.json 2>/dev/null; then
    info "sandbox '$name' has no provider credentials yet — run '/login' inside it first"
    return 0
  fi
  mkdir -p "$(dirname "$HOST_AUTH")"
  # Stage it, so an empty or truncated sandbox copy cannot replace good
  # host credentials with junk.
  local staged
  staged="$(mktemp)"
  sbx cp "$name:/home/agent/.pi/agent/auth.json" "$staged"
  if [ ! -s "$staged" ] || [ "$(tr -d '[:space:]' < "$staged")" = "{}" ]; then
    rm -f "$staged"
    info "sandbox '$name' has no provider credentials to save (empty auth.json) — leaving $HOST_AUTH alone"
    return 0
  fi
  mv "$staged" "$HOST_AUTH"
  chmod 600 "$HOST_AUTH"
  info "saved provider credentials to $HOST_AUTH"
}

# Git identity for commits made inside the sandbox. Defaults to the host's own
# git config, which is where it already lives; GIT_NAME/GIT_EMAIL override it.
configure_git_identity() {
  local name="$1" git_name git_email
  git_name="${GIT_NAME:-$(git config --get user.name || true)}"
  git_email="${GIT_EMAIL:-$(git config --get user.email || true)}"
  [ -n "$git_name" ] && sbx exec "$name" git config --global user.name "$git_name"
  [ -n "$git_email" ] && sbx exec "$name" git config --global user.email "$git_email"
  [ -n "$git_name" ] || info "no git identity on the host; sandbox commits will have none (set GIT_NAME/GIT_EMAIL or git config --global user.name)"
  # The signing key stays on the host and is unreachable from the VM.
  sbx exec "$name" git config --global commit.gpgsign false
  return 0
}

# Extra workspaces mount at their host absolute path, so a shared directory
# lands at that host path inside the VM rather than at pi's expected location
# under ~/.pi/agent. Symlink the latter to the former.
link_host_path() {
  local name="$1" src="$2" rel="$3" mode="${4:-}"
  info "linking ~/$rel -> $src${mode:+ ($mode)} inside the sandbox"
  sbx exec "$name" bash -c '
    set -eu
    src="$1" target="$HOME/$2"
    mkdir -p "$(dirname "$target")"
    if [ -L "$target" ] || [ ! -e "$target" ]; then
      ln -sfn "$src" "$target"
    else
      echo "safe-pi: $target already exists in the sandbox and is not a symlink; leaving it alone" >&2
    fi
  ' _ "$src" "$rel"
}

# True when $1 is $2 or a parent directory of $2.
is_ancestor_or_same() {
  case "$2/" in "$1"/*) return 0 ;; esac
  return 1
}

# Link a read-only source (extensions or skills) into the sandbox. Normally
# this is a live symlink onto the ':ro' bind mount 'extra_mounts' already set
# up, so edits on the host reach the sandbox immediately (and '/reload' picks
# them up for extensions).
#
# But 'sbx create' mounts a ':ro' path at its host absolute path, and that
# cannot be relocated: if the workspace itself contains $host_dir (running
# safe-pi in this repo, or in $HOME), the mount would land inside the
# read-write workspace mount and stop being read-only. In that case a
# snapshot is copied into the VM instead, at $copy_target, then chowned to
# root and stripped of write access for everyone else -- so the agent's own
# `edit`/`write` tools (which touch the filesystem directly, not through
# sudo) cannot modify it even though it is sitting inside their writable
# workspace. This is a guardrail against a mode quietly editing its own
# gating extensions, not a boundary: the agent has passwordless sudo in the
# VM (see spec.yaml), so a mode with `bash` can still get around it, same as
# gh-guard. There is no live '/reload' in this case; 'safe-pi sync' (or a
# fresh 'safe-pi') re-copies it.
link_ro_source() {
  local name="$1" host_dir="$2" copy_target="$3" link_rel="$4"
  if [ ! -d "$host_dir" ]; then
    return 0
  fi
  if is_ancestor_or_same "$PWD" "$host_dir"; then
    info "$host_dir is inside this workspace; copying it into the sandbox read-only instead of mounting it (run 'safe-pi sync' after editing it)"
    sbx exec "$name" sudo rm -rf "$copy_target"
    sbx cp "$host_dir" "$name:$copy_target"
    sbx exec "$name" sudo chown -R root:root "$copy_target"
    sbx exec "$name" sudo chmod -R u=rwX,go=rX "$copy_target"
    link_host_path "$name" "$copy_target" "$link_rel" "read-only, copied"
  else
    link_host_path "$name" "$host_dir" "$link_rel" "read-only"
  fi
}

# Running safe-pi from a directory that contains HOST_SESSIONS_DIR (this repo,
# or $HOME) would hand sbx a workspace mount plus a mount nested underneath
# it. Overlapping mounts are not something sbx promises to handle, so drop
# the redundant one: the workspace mount already exposes that path, and since
# it lands at its host absolute path, the in-VM symlink from link_host_path is
# correct either way. HOST_EXT_DIR/HOST_SKILLS_DIR are handled separately by
# link_ro_source, since dropping their mount on overlap would silently expose
# them read-write instead.
extra_mounts() {
  local path="$HOST_SESSIONS_DIR"
  if is_ancestor_or_same "$PWD" "$path"; then
    info "$path is inside this workspace; not mounting it a second time"
    return 0
  fi
  printf '%s\n' "$path"
}

# ':ro' mounts for HOST_EXT_DIR/HOST_SKILLS_DIR, for the common case where
# they do not overlap the workspace. link_ro_source relies on this having
# already run; when a path does overlap, it is deliberately absent here and
# copied instead.
ro_mounts() {
  local path
  for path in "$HOST_EXT_DIR" "$HOST_SKILLS_DIR"; do
    if is_ancestor_or_same "$PWD" "$path"; then
      continue
    fi
    printf '%s:ro\n' "$path"
  done
}

create_sandbox() {
  local name="$1" clone="$2"
  need_image
  info "creating sandbox '$name' for $PWD"
  mkdir -p "$HOST_EXT_DIR" "$HOST_SKILLS_DIR" "$HOST_SESSIONS_DIR"
  apply_offline_policy
  # Global secrets are injected at creation, so this has to happen before
  # 'sbx create' — and here, rather than in a step the user must remember.
  # Not forced: an already-stored secret is good enough to create with.
  store_github_secret

  local mounts=()
  while IFS= read -r m; do
    [ -n "$m" ] && mounts+=("$m")
  done < <(ro_mounts; extra_mounts)

  if [ "$clone" -eq 1 ]; then
    sbx create --kit "$KIT_DIR" --clone --name "$name" pi "$PWD" ${mounts+"${mounts[@]}"}
  else
    sbx create --kit "$KIT_DIR" --name "$name" pi "$PWD" ${mounts+"${mounts[@]}"}
  fi
  link_ro_source "$name" "$HOST_EXT_DIR" "$RO_COPY_EXT" ".pi/agent/extensions"
  link_ro_source "$name" "$HOST_SKILLS_DIR" "$RO_COPY_SKILLS" ".pi/agent/skills"
  link_host_path "$name" "$HOST_SESSIONS_DIR" ".pi/agent/sessions" "read-write"
  if [ -f "$HOST_KEYBINDINGS" ]; then
    sbx cp "$HOST_KEYBINDINGS" "$name:/home/agent/.pi/agent/keybindings.json"
    claim_for_agent "$name" /home/agent/.pi/agent/keybindings.json 644
  fi
  copy_auth_in "$name"
  configure_git_identity "$name"
  configure_offline_model "$name"
  sync_packages "$name"
  sync_package_config "$name"
}

cmd_login() {
  need_sbx
  store_github_secret force
  # Capture a '/login' done inside this directory's sandbox onto the host,
  # where the next sandbox picks it up.
  local name
  name="$(sandbox_name "$PWD")"
  sandbox_exists "$name" && save_auth_out "$name"
  return 0
}

cmd_offline() {
  need_sbx
  local name
  name="$(sandbox_name "$PWD")"
  apply_offline_policy
  sandbox_exists "$name" || die "no sandbox for this directory yet — run 'safe-pi' first"
  configure_offline_model "$name"
}

cmd_sync() {
  need_sbx
  local name
  name="$(sandbox_name "$PWD")"
  sandbox_exists "$name" || die "no sandbox for this directory yet — run 'safe-pi' first"
  sync_packages "$name"
  sync_package_config "$name"
  # Only meaningful when extensions/skills were copied rather than mounted
  # (see link_ro_source); harmless no-op otherwise since the mount already
  # reflects host edits live.
  link_ro_source "$name" "$HOST_EXT_DIR" "$RO_COPY_EXT" ".pi/agent/extensions"
  link_ro_source "$name" "$HOST_SKILLS_DIR" "$RO_COPY_SKILLS" ".pi/agent/skills"
}

cmd_rm() {
  need_sbx
  local name
  name="$(sandbox_name "$PWD")"
  sandbox_exists "$name" || die "no sandbox named '$name'"
  sbx rm "$name"
}

cmd_help() {
  cat <<EOF
safe-pi — run the pi coding agent in a Docker Sandbox against \$PWD.

Usage:
  safe-pi                 start pi against the current directory
  safe-pi <args...>       pass args/flags through to pi (e.g. safe-pi --version)
  safe-pi --clone         start pi on a private in-VM git clone (host repo read-only)
  safe-pi --shell         open a shell inside the sandbox
  safe-pi login           store the GitHub token, and save this sandbox's
                          provider credentials to the host for the next one
  safe-pi offline         re-apply the local model config to this sandbox
  safe-pi sync            re-install the host's global pi packages into this sandbox
  safe-pi rm              delete the sandbox for the current directory
  safe-pi --help          show this message

There is no config file. The sandbox git identity comes from your host git
config and the GitHub token from 'gh auth token'. GIT_NAME, GIT_EMAIL,
GITHUB_TOKEN, OFFLINE_PORT and OFFLINE_MODEL override those from the
environment.
Provider credentials are copied into each new sandbox from
$HOST_AUTH
so '/login' is a one-time step: run it inside your first sandbox, then
'safe-pi login' saves it to the host for every later one.
Each project directory gets its own sandbox; state persists until 'safe-pi rm'.
Pi configuration is tracked in this repo under extensions/,
installed-extensions/, skills/ and config/, which ~/.pi links to child by
child. Credentials and sessions are not tracked; they live in ~/.pi.
Extensions in $HOST_EXT_DIR and skills in $HOST_SKILLS_DIR are shared
read-only with every sandbox.
Sessions in $HOST_SESSIONS_DIR are shared read-write with every sandbox
(keyed by encoded cwd/repo path).
Keybindings in $HOST_KEYBINDINGS are shared read-only with every sandbox.
Packages listed in $HOST_SETTINGS are installed into each sandbox at
creation, pinned to the exact versions in installed-extensions/package.json;
package config (any other top-level key in $HOST_SETTINGS, e.g. "tldr") is
copied in too. Run 'safe-pi sync' after changing either.

If the workspace itself contains $HOST_SESSIONS_DIR, it is not mounted a
second time, since the workspace mount already covers it. If it contains
$HOST_EXT_DIR or $HOST_SKILLS_DIR, they are copied into the sandbox read-only
instead of mounted, since a ':ro' mount cannot be placed inside a read-write
workspace mount; run 'safe-pi sync' after editing them in that case.
EOF
}

case "${1:-}" in
  login) shift; cmd_login; exit 0 ;;
  offline) shift; cmd_offline; exit 0 ;;
  sync) shift; cmd_sync; exit 0 ;;
  rm) shift; cmd_rm; exit 0 ;;
  -h|--help) cmd_help; exit 0 ;;
esac

need_sbx

CLONE=0
SHELL_MODE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --clone) CLONE=1; shift ;;
    --shell) SHELL_MODE=1; shift ;;
    *) break ;;
  esac
done

NAME="$(sandbox_name "$PWD")"

if ! sandbox_exists "$NAME"; then
  create_sandbox "$NAME" "$CLONE"
elif [ "$CLONE" -eq 1 ]; then
  info "sandbox '$NAME' already exists; --clone is fixed at creation time (run 'safe-pi rm' first to change it)"
fi

if [ "$SHELL_MODE" -eq 1 ]; then
  exec sbx exec -it "$NAME" bash
elif [ $# -gt 0 ]; then
  exec sbx run --name "$NAME" -- "$@"
else
  exec sbx run --name "$NAME"
fi
